{
  "name": "dsh-quota-ring",
  "version": "1.0.0",
  "type": "module",
  "description": "iPhone Duo style quota/battery rings beside the composer, one per configured AI provider (DeepSeek, GLM, Kimi, MiniMax, OpenCode, OpenRouter, Codex), with per-ring styles.",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "quota",
    "balance",
    "glm",
    "deepseek"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
